# FatSecret Platform developer app (platform.fatsecret.com) — Premier tier
# recommended for non-US food/recipe data (Basic is US-only).
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_OAUTH2_SCOPE=basic

# Set true ONLY if the FatSecret Platform app is actually on the paid Premier
# tier (the consumer app subscription does NOT count). Unlocks non-US food data,
# custom foods (food.create) and listing favorites. On Basic those tools are not
# registered at all rather than offered and always failing.
FATSECRET_PREMIER=false

# Encrypts per-user OAuth1 tokens at rest (min 16 chars). Keep secret; never commit.
FATSECRET_ENCRYPTION_KEY=
FATSECRET_STORE_PATH=/data/store.json

# Bind every call to the gateway-verified user (X-MCP-User). Required for the
# hosted, multi-user deployment so each user sees only their own diary.
FATSECRET_TRUST_FORWARDED_USER=true

FATSECRET_ENABLE_WRITES=true

# Fallback account-less auth path (profile.create) — dev/test only. Leave
# false in production; the primary flow is fatsecret_start_auth/complete_auth
# against a real fatsecret.com account.
FATSECRET_ENABLE_PROFILE_CREATE=false

FATSECRET_POLICY_PATH=
FATSECRET_AUDIT_LOG=
FATSECRET_TIMEOUT_MS=30000

# Local-only: lets you exercise per-user tools over stdio without a gateway
# forwarding a real X-MCP-User header. Never set in a hosted deployment.
FATSECRET_DEV_USER=

MCP_HTTP_TOKEN=
